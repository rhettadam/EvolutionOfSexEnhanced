<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[;------------------------------------------------------------------------------------
;:::::: Evolution of Sex ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

globals [
  ;; allele domains
  allele-color-types
  allele-size-types
  parasite-size-types

  ;; cached UI toggles
  last-show-parasites

  ;; parasite population bounds
  parasite-min-pop
  parasite-max-pop

  ;; strategy trails (patch shading)
  trail-radius
  trail-fade

  ;; setup scaling
  initial-parasite-fraction

  ;; cached constants
  patch-count
]

breed [ snails snail ]
breed [ parasites parasite ]

snails-own [
  allele-color-1
  allele-color-2
  allele-size-1
  allele-size-2
  sex
  infecting-parasite
]

parasites-own [
  my-host
]

patches-own [
  asexual-trail
  sexual-trail
]

;------------------------------------------------------------------------------------
;:::::: Setup :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to setup
  clear-all

  setup-global-parameters
  setup-patches
  setup-snails
  setup-parasites
  
  update-parasite-visibility
  update-trail-visibility
  reset-ticks
end

to setup-global-parameters
  set patch-count count patches

  set last-show-parasites show-parasites

  set allele-size-types [ 1 3 ]
  set allele-color-types [ orange blue ]
  setup-parasite-size-types

  set parasite-min-pop 10
  set parasite-max-pop 50000

  set trail-radius 3
  set trail-fade 0.90

  set initial-parasite-fraction 0.1
end

to setup-parasite-size-types
  set parasite-size-types []
  foreach allele-size-types [ i ->
    foreach allele-size-types [ j ->
      set parasite-size-types lput ((i + j) / 2) parasite-size-types
    ]
  ]
  set parasite-size-types remove-duplicates parasite-size-types
end

to setup-patches
  ask patches [
    set pcolor white
    set asexual-trail 0
    set sexual-trail 0
  ]
end

to setup-snails
  let n-total round snail-carrying-capacity
  let n-sexual round (n-total * (initial-percent-sexual / 100))
  let n-asexual (n-total - n-sexual)

  create-snails n-total [
    set hidden? false
    set label ""
    set infecting-parasite nobody
    setxy random-xcor random-ycor

    ifelse who < n-sexual
    [ set sex coin-flip-sex ]
    [ set sex "asexual" ]

    set allele-color-1 initialize-color-allele
    set allele-color-2 initialize-color-allele
    set allele-size-1 initialize-size-allele
    set allele-size-2 initialize-size-allele

    set-size-shape-color
  ]
end

to setup-parasites
  if parasite-infection-chance > 0 [
    create-parasites (initial-parasite-fraction * snail-carrying-capacity) [
      initialize-parasite
    ]
  ]
end

to initialize-parasite
  set label ""
  set hidden? (not show-parasites)
  set shape "circle"
  setxy random-xcor random-ycor
  set color ((one-of allele-color-types) - 2)
  set size (one-of parasite-size-types) / 3
  set my-host nobody
end

to-report coin-flip-sex
  ifelse random-float 1.0 < 0.5 [ report "male" ] [ report "female" ]
end

to-report initialize-color-allele
  report one-of allele-color-types
end

to-report initialize-size-allele
  report one-of allele-size-types
end

to set-size-shape-color
  set size (allele-size-1 + allele-size-2) / 2
  set shape get-snail-shape

  let idx1 position allele-color-1 allele-color-types
  let idx2 position allele-color-2 allele-color-types
  ifelse idx1 >= idx2
  [ set color allele-color-1 ]
  [ set color allele-color-2 ]
end

to-report get-snail-shape
  if sex = "asexual" [ ifelse heading < 180 [ report "asexual right" ] [ report "asexual left" ] ]
  if sex = "male"    [ ifelse heading < 180 [ report "male right"    ] [ report "male left"    ] ]
  if sex = "female"  [ ifelse heading < 180 [ report "female right"  ] [ report "female left"  ] ]
end

;------------------------------------------------------------------------------------
;:::::: Go ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to go
  if ticks = stop-simulation-at [ stop ]

  ;; mating radius (% world width -> patches)
  let mate-radius ((sexual-mating-radius / 100) * world-width)

  ;; Beverton–Holt density dependence: fertility declines with density but never hits zero
  let snailN count snails
  let snailK snail-carrying-capacity

  let density-factor 0
  ifelse snailK > 0
  [ set density-factor (snailN / snailK) ]
  [ set density-factor 0 ]

  let effective-snail-fertility (snail-fertility-rate / (1 + density-factor))

  ;; snails step
  ask snails [
    snails-wander
    snail-reproduce-logistic effective-snail-fertility mate-radius
    set shape get-snail-shape
  ]

  ;; hard cap at carrying capacity (removes excess snails, if any)
  let afterN count snails
  if (snailK > 0 and afterN > snailK) [
    ask n-of (afterN - snailK) snails [ remove-snail ]
  ]
  
  ;; parasites step (only if infection is enabled)
  if parasite-infection-chance > 0 [
    parasites-go
    enforce-parasite-bounds
  ]
  
  update-parasite-visibility
  update-trail-visibility
  
  tick
end

to-report compute-encounter-prob [mate-radius male-count]
  if male-count = 0 [ report 0 ]

  ;; male density (males per patch)
  let male-density (male-count / patch-count)

  ;; expected males within radius
  let area (pi * mate-radius * mate-radius)
  let lambda (male-density * area)

  ;; Poisson: P(>=1) = 1 - exp(-lambda)
  report (1 - exp (0 - lambda))
end

to update-parasite-visibility
  if show-parasites != last-show-parasites [
    ask parasites [ set hidden? (not show-parasites) ]
    set last-show-parasites show-parasites
  ]
end

to update-trail-visibility
  ifelse show-strategies
  [ update-snail-trails ]
  [ ask patches [ set pcolor white ] ]
end

;------------------------------------------------------------------------------------
;:::::: Strategy trails ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to update-snail-trails
  ;; fade
  ask patches [
    set asexual-trail (asexual-trail * trail-fade)
    set sexual-trail  (sexual-trail  * trail-fade)

    if asexual-trail < 0.01 [ set asexual-trail 0 ]
    if sexual-trail  < 0.01 [ set sexual-trail  0 ]
  ]

  ;; deposit
  ask snails [
    if sex = "asexual" [
      ask patches in-radius trail-radius [ set asexual-trail 1 ]
    ]
    if sex != "asexual" [
      ask patches in-radius trail-radius [ set sexual-trail 1 ]
    ]
  ]

  ;; render (two colors only)
  ask patches [
    ifelse sexual-trail > 0
    [ set pcolor 7 ]          ;; sexual = darker gray
    [
      ifelse asexual-trail > 0
      [ set pcolor 9 ]        ;; asexual = lighter gray
      [ set pcolor white ]
    ]
  ]
end

;------------------------------------------------------------------------------------
;:::::: Snails ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to snails-wander
  right random 90
  left random 90
  fd 0.3
  if infecting-parasite != nobody [
    ask infecting-parasite [ move-to myself ]
  ]
end

to snail-reproduce-logistic [effective-snail-fertility mate-radius]
  if random-float 1.0 < effective-snail-fertility [
    if infecting-parasite = nobody [
      if sex = "asexual" [
        snails-reproduce-asexually
      ]
      if sex = "female" [
        snails-reproduce-sexually mate-radius
      ]
    ]
  ]
end

to snails-reproduce-sexually [mate-radius]
  let local-males snails in-radius mate-radius with [ sex = "male" ]
  if any? local-males [
    let mate one-of local-males
    hatch-snails 1 [
      set allele-color-1 one-of (list allele-color-1 ([allele-color-1] of mate))
      set allele-color-2 one-of (list allele-color-2 ([allele-color-2] of mate))
      set allele-size-1  one-of (list allele-size-1  ([allele-size-1]  of mate))
      set allele-size-2  one-of (list allele-size-2  ([allele-size-2]  of mate))

      set sex coin-flip-sex
      snails-update-for-mutation
      set-size-shape-color
    ]
  ]
end

to snails-reproduce-asexually
  hatch-snails 1 [
    snails-update-for-mutation
    set-size-shape-color
  ]
end

to snails-update-for-mutation
  if random-float 1.0 < snail-mutation-rate [ set allele-color-1 initialize-color-allele ]
  if random-float 1.0 < snail-mutation-rate [ set allele-color-2 initialize-color-allele ]
  if random-float 1.0 < snail-mutation-rate [ set allele-size-1 initialize-size-allele ]
  if random-float 1.0 < snail-mutation-rate [ set allele-size-2 initialize-size-allele ]
end

to remove-snail
  if infecting-parasite != nobody [ ask infecting-parasite [ die ] ]
  die
end

;------------------------------------------------------------------------------------
;:::::: Parasites :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to parasites-go
  let snailN count snails
  let parasiteN count parasites

  ;; compute crowding + effective fertility once per tick
  let effective-parasite-fertility parasite-fertility-rate
  if (snailN > 0 and per-snail-parasite-capacity > 0) [
    let pps (parasiteN / snailN)
    set effective-parasite-fertility (parasite-fertility-rate / (1 + (pps / per-snail-parasite-capacity)))
  ]

  ask parasites [
    parasite-wander
    parasites-reproduce effective-parasite-fertility
    parasite-death
  ]
end

to enforce-parasite-bounds
  let current count parasites

  if current > parasite-max-pop [
    ask n-of (current - parasite-max-pop) parasites [ die ]
  ]

  if current < parasite-min-pop [
    create-parasites (parasite-min-pop - current) [
      initialize-parasite
    ]
  ]
end

to parasite-wander
  if my-host != nobody [ stop ]
  right random 30
  left random 30
  fd 0.7
  attempt-infection
end

to parasites-reproduce [effective-parasite-fertility]
  if my-host = nobody [ stop ]

  if random-float 1.0 < effective-parasite-fertility [
    hatch-parasites 1 [
      if random-float 1.0 < parasite-mutation-rate [
        set color ((one-of allele-color-types) - 2)
        set size (one-of parasite-size-types) / 3
        set my-host nobody
      ]
    ]
  ]
end

to attempt-infection
  let local-snails snails-here with [ infecting-parasite = nobody ]
  if any? local-snails [
    let target one-of local-snails
    let matching? ( [color] of target = (color + 2) ) and ( [size]  of target = (size * 3) )
    if matching? [
      if random-float 100 < parasite-infection-chance [
        ask target [ set infecting-parasite myself ]
        set my-host target
      ]
    ]
  ]
end

to parasite-death
  if random-float 1.0 < parasite-mortality-rate [
    if my-host != nobody [ ask my-host [ remove-snail ] ]
    die
  ]
end
]]></code>
