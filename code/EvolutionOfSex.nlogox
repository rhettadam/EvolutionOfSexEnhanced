    <plot x="815" autoPlotX="true" yMax="100.0" autoPlotY="false" yAxis="percent of individuals" y="17" xMin="0.0" height="315" legend="true" xMax="10.0" yMin="0.0" width="319" xAxis="timesteps" display="Sexual vs Asexual Strategies">
