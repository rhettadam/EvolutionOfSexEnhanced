  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="E0_baseline_check" repetitions="15" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="5000">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>count snails</metric>
        <metric>count-asexual</metric>
        <metric>count-sexual</metric>
        <metric>count-selfing</metric>
        <metric>count parasites</metric>
        <metric>pct-asexual</metric>
        <metric>pct-sexual</metric>
        <metric>pct-selfing</metric>
        <metric>mean-het-asexual</metric>
        <metric>mean-het-sexual</metric>
        <metric>mean-het-selfing</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="stop-simulation-at"><value value="5000"></value></enumeratedValueSet>
        <enumeratedValueSet variable="show-parasites"><value value="false"></value></enumeratedValueSet>
        <enumeratedValueSet variable="patch-display"><value value="&quot;none&quot;"></value></enumeratedValueSet>
        <enumeratedValueSet variable="initial-percent-sexual"><value value="50"></value></enumeratedValueSet>
        <enumeratedValueSet variable="initial-percent-self-fertilizing"><value value="0"></value></enumeratedValueSet>
        <enumeratedValueSet variable="self-fertilizing-cost"><value value="0"></value></enumeratedValueSet>
        <enumeratedValueSet variable="snail-carrying-capacity"><value value="5000"></value></enumeratedValueSet>
        <enumeratedValueSet variable="snail-fertility-rate"><value value="0.01"></value></enumeratedValueSet>
        <enumeratedValueSet variable="snail-mutation-rate"><value value="0.001"></value></enumeratedValueSet>
        <enumeratedValueSet variable="sexual-mating-radius"><value value="50"></value></enumeratedValueSet>
        <enumeratedValueSet variable="parasite-infection-chance"><value value="0"></value><value value="70"></value></enumeratedValueSet>
        <enumeratedValueSet variable="per-snail-parasite-capacity"><value value="5"></value></enumeratedValueSet>
        <enumeratedValueSet variable="parasite-fertility-rate"><value value="0.5"></value></enumeratedValueSet>
        <enumeratedValueSet variable="parasite-mortality-rate"><value value="0.01"></value></enumeratedValueSet>
        <enumeratedValueSet variable="parasite-mutation-rate"><value value="0.1"></value></enumeratedValueSet>
        <enumeratedValueSet variable="mendelian-segregation?"><value value="false"></value><value value="true"></value></enumeratedValueSet>
        <enumeratedValueSet variable="release-offspring?"><value value="false"></value></enumeratedValueSet>
        <enumeratedValueSet variable="use-salinity-gradient?"><value value="false"></value></enumeratedValueSet>
        <enumeratedValueSet variable="use-temperature-gradient?"><value value="false"></value></enumeratedValueSet>
        <enumeratedValueSet variable="infection-chance-west"><value value="0"></value></enumeratedValueSet>
