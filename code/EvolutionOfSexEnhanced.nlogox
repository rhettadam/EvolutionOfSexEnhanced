<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[
;------------------------------------------------------------------------------------
;:::::: Evolution of Sex (Enhanced) :::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------
; Builds on Kristin Crouse's Evolution of Sex (v1.2.1).
; Adds self-fertilization, Mendelian segregation, parasite offspring release,
; salinity / temperature gradients, and spatial observation outputs.
; With all new modules off (and initial-percent-self-fertilizing = 0),
; behavior matches the original model.
;------------------------------------------------------------------------------------

globals [
  ;; allele domains
  allele-color-types
  allele-size-types
  parasite-size-types

  ;; cached UI toggles
  last-show-parasites

  ;; parasite population bounds
  parasite-min-pop
  parasite-max-pop

  ;; strategy trails (patch shading)
  trail-radius
  trail-fade

  ;; setup scaling
  initial-parasite-fraction

  ;; cached constants
  patch-count

  ;; observation / output
  output-interval
  n-strips
  boundary-window-ticks
  samples-in-window

  ;; rolling strip sums (length n-strips), updated every output-interval ticks
  strip-asexual-sum
  strip-sexual-sum
  strip-selfing-sum
  strip-total-sum
  strip-sample-count

  ;; latest recorded summaries (for monitors / BehaviorSpace)
  mean-het-asexual
  mean-het-sexual
  mean-het-selfing
  boundary-position-asexual
  boundary-width-asexual
  boundary-position-sexual
  boundary-width-sexual
  boundary-position-selfing
  boundary-width-selfing
]

breed [ snails snail ]
breed [ parasites parasite ]

snails-own [
  allele-color-1
  allele-color-2
  allele-size-1
  allele-size-2
  sex
  infecting-parasite
]

parasites-own [
  my-host
]

patches-own [
  asexual-trail
  sexual-trail
  self-fertilizing-trail
]

;------------------------------------------------------------------------------------
;:::::: Setup :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to setup
  clear-all

  setup-global-parameters
  setup-patches
  setup-snails
  setup-parasites

  update-parasite-visibility
  update-world-display
  reset-ticks
end

to setup-global-parameters
  set patch-count count patches

  set last-show-parasites show-parasites

  set allele-size-types [ 1 3 ]
  set allele-color-types [ orange blue ]
  setup-parasite-size-types

  set parasite-min-pop 10
  set parasite-max-pop 50000

  set trail-radius 3
  set trail-fade 0.90

  set initial-parasite-fraction 0.1

  set output-interval 25
  set n-strips 20
  set boundary-window-ticks 500
  set samples-in-window max (list 1 (floor (boundary-window-ticks / output-interval)))

  reset-observation-state
end

to reset-observation-state
  set strip-asexual-sum n-values n-strips [ 0 ]
  set strip-sexual-sum n-values n-strips [ 0 ]
  set strip-selfing-sum n-values n-strips [ 0 ]
  set strip-total-sum n-values n-strips [ 0 ]
  set strip-sample-count 0

  set mean-het-asexual 0
  set mean-het-sexual 0
  set mean-het-selfing 0
  set boundary-position-asexual -1
  set boundary-width-asexual -1
  set boundary-position-sexual -1
  set boundary-width-sexual -1
  set boundary-position-selfing -1
  set boundary-width-selfing -1
end

to setup-parasite-size-types
  set parasite-size-types []
  foreach allele-size-types [ i ->
    foreach allele-size-types [ j ->
      set parasite-size-types lput ((i + j) / 2) parasite-size-types
    ]
  ]
  set parasite-size-types remove-duplicates parasite-size-types
end

to setup-patches
  ask patches [
    set pcolor white
    set asexual-trail 0
    set sexual-trail 0
    set self-fertilizing-trail 0
  ]
end

to setup-snails
  let n-total round snail-carrying-capacity
  let n-sexual round (n-total * (initial-percent-sexual / 100))
  let n-selfing round (n-total * (initial-percent-self-fertilizing / 100))
  if (n-sexual + n-selfing) > n-total [
    set n-selfing max (list 0 (n-total - n-sexual))
  ]
  let n-asexual (n-total - n-sexual - n-selfing)

  create-snails n-total [
    set hidden? false
    set label ""
    set infecting-parasite nobody
    setxy random-xcor random-ycor

    ifelse who < n-sexual
    [ set sex coin-flip-sex ]
    [
      ifelse who < (n-sexual + n-selfing)
      [ set sex "self-fertile" ]
      [ set sex "asexual" ]
    ]

    set allele-color-1 initialize-color-allele
    set allele-color-2 initialize-color-allele
    set allele-size-1 initialize-size-allele
    set allele-size-2 initialize-size-allele

    set-size-shape-color
  ]
end

to setup-parasites
  if infection-possible? [
    create-parasites (initial-parasite-fraction * snail-carrying-capacity) [
      initialize-parasite
    ]
  ]
end

to initialize-parasite
  set label ""
  set hidden? (not show-parasites)
  set shape "circle"
  setxy random-xcor random-ycor
  set color ((one-of allele-color-types) - 2)
  set size (one-of parasite-size-types) / 3
  set my-host nobody
end

to-report coin-flip-sex
  ifelse random-float 1.0 < 0.5 [ report "male" ] [ report "female" ]
end

to-report initialize-color-allele
  report one-of allele-color-types
end

to-report initialize-size-allele
  report one-of allele-size-types
end

to set-size-shape-color
  set size (allele-size-1 + allele-size-2) / 2
  set shape get-snail-shape

  let idx1 position allele-color-1 allele-color-types
  let idx2 position allele-color-2 allele-color-types
  ifelse idx1 >= idx2
  [ set color allele-color-1 ]
  [ set color allele-color-2 ]
end

to-report get-snail-shape
  if sex = "asexual" [
    ifelse heading < 180 [ report "asexual right" ] [ report "asexual left" ]
  ]
  if sex = "self-fertile" [
    ifelse heading < 180 [ report "self-fertile right" ] [ report "self-fertile left" ]
  ]
  if sex = "male" [
    ifelse heading < 180 [ report "male right" ] [ report "male left" ]
  ]
  if sex = "female" [
    ifelse heading < 180 [ report "female right" ] [ report "female left" ]
  ]
  report "circle"
end

;------------------------------------------------------------------------------------
;:::::: Environment helpers :::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to-report infection-possible?
  ifelse use-salinity-gradient?
  [ report (infection-chance-west > 0) or (infection-chance-east > 0) ]
  [ report parasite-infection-chance > 0 ]
end

;; S(x) = min(1, max(0, 0.5 + (x - xc) / (w * world-width)))
to-report patch-salinity [px]
  let world-w world-width
  let xc (gradient-center / 100) * world-w
  let width-frac max (list 0.01 gradient-width)
  report min (list 1 max (list 0 (0.5 + (px - xc) / (width-frac * world-w))))
end

;; I(x) = Iw + (Ie - Iw) * S(x)
to-report local-infection-chance
  ifelse use-salinity-gradient?
  [
    let S patch-salinity pxcor
    report infection-chance-west + (infection-chance-east - infection-chance-west) * S
  ]
  [ report parasite-infection-chance ]
end

;; T(y) linear from 0 (south) to 1 (north)
to-report patch-temperature [py]
  let span (max-pycor - min-pycor)
  if span <= 0 [ report 0.5 ]
  report (py - min-pycor) / span
end

;; r(y) = r0 * (1 - c * (1 - T(y)))
to-report local-mate-radius [base-radius]
  ifelse use-temperature-gradient?
  [
    let T patch-temperature pycor
    report base-radius * (1 - cold-mating-penalty * (1 - T))
  ]
  [ report base-radius ]
end

;; Move forward, but when a gradient is on, bounce at that axis edge
;; instead of wrapping so the extremes are never adjacent.
to move-with-gradient-edges [dist]
  let new-x (xcor + dist * dx)
  let new-y (ycor + dist * dy)
  if use-salinity-gradient? [
    if new-x < min-pxcor [ set new-x min-pxcor set heading (- heading) ]
    if new-x > max-pxcor [ set new-x max-pxcor set heading (- heading) ]
  ]
  if use-temperature-gradient? [
    if new-y < min-pycor [ set new-y min-pycor set heading (180 - heading) ]
    if new-y > max-pycor [ set new-y max-pycor set heading (180 - heading) ]
  ]
  setxy new-x new-y
end

;------------------------------------------------------------------------------------
;:::::: Go ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to go
  if ticks = stop-simulation-at [ stop ]

  ;; mating radius (% world width -> patches)
  let mate-radius ((sexual-mating-radius / 100) * world-width)

  ;; Beverton–Holt density dependence: fertility declines with density but never hits zero
  let snailN count snails
  let snailK snail-carrying-capacity

  let density-factor 0
  ifelse snailK > 0
  [ set density-factor (snailN / snailK) ]
  [ set density-factor 0 ]

  let effective-snail-fertility (snail-fertility-rate / (1 + density-factor))

  ;; snails step
  ask snails [
    snails-wander
    snail-reproduce-logistic effective-snail-fertility mate-radius
    set shape get-snail-shape
  ]

  ;; hard cap at carrying capacity (removes excess snails, if any)
  let afterN count snails
  if (snailK > 0 and afterN > snailK) [
    ask n-of (afterN - snailK) snails [ remove-snail ]
  ]

  ;; parasites step (only if infection is enabled)
  if infection-possible? [
    parasites-go
    enforce-parasite-bounds
  ]

  update-parasite-visibility
  update-world-display

  if (ticks > 0) and (ticks mod output-interval = 0) [
    record-output
  ]

  tick
end

to-report compute-encounter-prob [mate-radius male-count]
  if male-count = 0 [ report 0 ]

  ;; male density (males per patch)
  let male-density (male-count / patch-count)

  ;; expected males within radius
  let area (pi * mate-radius * mate-radius)
  let lambda (male-density * area)

  ;; Poisson: P(>=1) = 1 - exp(-lambda)
  report (1 - exp (0 - lambda))
end

to update-parasite-visibility
  if show-parasites != last-show-parasites [
    ask parasites [ set hidden? (not show-parasites) ]
    set last-show-parasites show-parasites
  ]
end

to update-world-display
  ;; "none" leaves the white setup background; do not repaint 90k patches every tick
  if patch-display = "none" [ stop ]
  if patch-display = "strategies" [
    update-snail-trails
    stop
  ]
  if patch-display = "salinity" [
    ask patches [ set pcolor scale-color sky (patch-salinity pxcor) 0 1 ]
    stop
  ]
  if patch-display = "infection" [
    ;; paints the infection field under current settings
    ask patches [
      let I ifelse-value use-salinity-gradient?
        [ infection-chance-west + (infection-chance-east - infection-chance-west) * (patch-salinity pxcor) ]
        [ parasite-infection-chance ]
      set pcolor scale-color red (I / 100) 0 1
    ]
    stop
  ]
  if patch-display = "temperature" [
    ask patches [ set pcolor scale-color orange (patch-temperature pycor) 0 1 ]
    stop
  ]
  if patch-display = "mate-radius" [
    ;; relative female search: 1 warm, (1 - cold-mating-penalty) cold
    ask patches [
      let factor 1
      if use-temperature-gradient? [
        set factor (1 - cold-mating-penalty * (1 - patch-temperature pycor))
      ]
      set pcolor scale-color lime factor 0 1
    ]
    stop
  ]
  ask patches [ set pcolor white ]
end

;------------------------------------------------------------------------------------
;:::::: Strategy trails ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to update-snail-trails
  ;; fade
  ask patches [
    set asexual-trail (asexual-trail * trail-fade)
    set sexual-trail  (sexual-trail  * trail-fade)
    set self-fertilizing-trail (self-fertilizing-trail * trail-fade)

    if asexual-trail < 0.01 [ set asexual-trail 0 ]
    if sexual-trail  < 0.01 [ set sexual-trail  0 ]
    if self-fertilizing-trail < 0.01 [ set self-fertilizing-trail 0 ]
  ]

  ;; deposit
  ask snails [
    if sex = "asexual" [
      ask patches in-radius trail-radius [ set asexual-trail 1 ]
    ]
    if sex = "self-fertile" [
      ask patches in-radius trail-radius [ set self-fertilizing-trail 1 ]
    ]
    if sex = "male" or sex = "female" [
      ask patches in-radius trail-radius [ set sexual-trail 1 ]
    ]
  ]

  ;; distinct colors so strategies are readable on the view
  ask patches [
    ifelse sexual-trail > 0
    [ set pcolor violet ]
    [
      ifelse self-fertilizing-trail > 0
      [ set pcolor lime ]
      [
        ifelse asexual-trail > 0
        [ set pcolor yellow ]
        [ set pcolor white ]
      ]
    ]
  ]
end

;------------------------------------------------------------------------------------
;:::::: Snails ::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to snails-wander
  right random 90
  left random 90
  move-with-gradient-edges 0.3
  if infecting-parasite != nobody [
    ask infecting-parasite [ move-to myself ]
  ]
end

to snail-reproduce-logistic [effective-snail-fertility mate-radius]
  if infecting-parasite != nobody [ stop ]

  if sex = "asexual" [
    if random-float 1.0 < effective-snail-fertility [
      snails-reproduce-asexually
    ]
  ]

  if sex = "female" [
    if random-float 1.0 < effective-snail-fertility [
      snails-reproduce-sexually (local-mate-radius mate-radius)
    ]
  ]

  if sex = "self-fertile" [
    let selfing-fertility (effective-snail-fertility * (1 - self-fertilizing-cost))
    if random-float 1.0 < selfing-fertility [
      snails-reproduce-selfing
    ]
  ]
end

to snails-reproduce-sexually [mate-radius]
  let local-males snails in-radius mate-radius with [ sex = "male" ]
  if any? local-males [
    let mate one-of local-males
    let mom-c1 allele-color-1
    let mom-c2 allele-color-2
    let mom-s1 allele-size-1
    let mom-s2 allele-size-2
    let dad-c1 [allele-color-1] of mate
    let dad-c2 [allele-color-2] of mate
    let dad-s1 [allele-size-1] of mate
    let dad-s2 [allele-size-2] of mate

    hatch-snails 1 [
      ifelse mendelian-segregation?
      [
        set allele-color-1 one-of (list mom-c1 mom-c2)
        set allele-color-2 one-of (list dad-c1 dad-c2)
        set allele-size-1  one-of (list mom-s1 mom-s2)
        set allele-size-2  one-of (list dad-s1 dad-s2)
      ]
      [
        ;; original slot-wise inheritance
        set allele-color-1 one-of (list mom-c1 dad-c1)
        set allele-color-2 one-of (list mom-c2 dad-c2)
        set allele-size-1  one-of (list mom-s1 dad-s1)
        set allele-size-2  one-of (list mom-s2 dad-s2)
      ]

      set sex coin-flip-sex
      snails-update-for-mutation
      set-size-shape-color
    ]
  ]
end

to snails-reproduce-asexually
  hatch-snails 1 [
    snails-update-for-mutation
    set-size-shape-color
  ]
end

;; Self-fertile snails hatch from two of their own gametes.
;; Without mendelian-segregation?, this is an exact clone (original slot logic on one parent).
;; With mendelian-segregation?, each locus draws two independent alleles from the parent (1:2:1).
to snails-reproduce-selfing
  let p-c1 allele-color-1
  let p-c2 allele-color-2
  let p-s1 allele-size-1
  let p-s2 allele-size-2

  hatch-snails 1 [
    ifelse mendelian-segregation?
    [
      set allele-color-1 one-of (list p-c1 p-c2)
      set allele-color-2 one-of (list p-c1 p-c2)
      set allele-size-1  one-of (list p-s1 p-s2)
      set allele-size-2  one-of (list p-s1 p-s2)
    ]
    [
      ;; hatch already copied parent alleles (exact clone before mutation)
    ]

    set sex "self-fertile"
    snails-update-for-mutation
    set-size-shape-color
  ]
end

to snails-update-for-mutation
  if random-float 1.0 < snail-mutation-rate [ set allele-color-1 initialize-color-allele ]
  if random-float 1.0 < snail-mutation-rate [ set allele-color-2 initialize-color-allele ]
  if random-float 1.0 < snail-mutation-rate [ set allele-size-1 initialize-size-allele ]
  if random-float 1.0 < snail-mutation-rate [ set allele-size-2 initialize-size-allele ]
end

to remove-snail
  if infecting-parasite != nobody [ ask infecting-parasite [ die ] ]
  die
end

;------------------------------------------------------------------------------------
;:::::: Parasites :::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to parasites-go
  let snailN count snails
  let parasiteN count parasites

  ;; compute crowding + effective fertility once per tick
  let effective-parasite-fertility parasite-fertility-rate
  if (snailN > 0 and per-snail-parasite-capacity > 0) [
    let pps (parasiteN / snailN)
    set effective-parasite-fertility (parasite-fertility-rate / (1 + (pps / per-snail-parasite-capacity)))
  ]

  ask parasites [
    parasite-wander
    parasites-reproduce effective-parasite-fertility
    parasite-death
  ]
end

to enforce-parasite-bounds
  let current count parasites

  if current > parasite-max-pop [
    ask n-of (current - parasite-max-pop) parasites [ die ]
  ]

  if current < parasite-min-pop [
    create-parasites (parasite-min-pop - current) [
      initialize-parasite
    ]
  ]
end

to parasite-wander
  if my-host != nobody [ stop ]
  right random 30
  left random 30
  move-with-gradient-edges 0.7
  attempt-infection
end

to parasites-reproduce [effective-parasite-fertility]
  if my-host = nobody [ stop ]

  if random-float 1.0 < effective-parasite-fertility [
    hatch-parasites 1 [
      ifelse release-offspring?
      [
        ;; every offspring is free; mutation independently reshuffles strategy
        set my-host nobody
        if random-float 1.0 < parasite-mutation-rate [
          set color ((one-of allele-color-types) - 2)
          set size (one-of parasite-size-types) / 3
        ]
      ]
      [
        ;; original: stay on parent host unless mutation also releases
        if random-float 1.0 < parasite-mutation-rate [
          set color ((one-of allele-color-types) - 2)
          set size (one-of parasite-size-types) / 3
          set my-host nobody
        ]
      ]
    ]
  ]
end

to attempt-infection
  let local-snails snails-here with [ infecting-parasite = nobody ]
  if any? local-snails [
    let target one-of local-snails
    let matching? ( [color] of target = (color + 2) ) and ( [size] of target = (size * 3) )
    if matching? [
      if random-float 100 < local-infection-chance [
        ask target [ set infecting-parasite myself ]
        set my-host target
      ]
    ]
  ]
end

to parasite-death
  if random-float 1.0 < parasite-mortality-rate [
    if my-host != nobody [ ask my-host [ remove-snail ] ]
    die
  ]
end

to-report count-free-parasites
  report count parasites with [ my-host = nobody ]
end

to-report count-hosted-parasites
  report count parasites with [ my-host != nobody ]
end

;------------------------------------------------------------------------------------
;:::::: Observation / reporters :::::::::::::::::::::::::::::::::::::::::::::::::::::
;------------------------------------------------------------------------------------

to-report snail-heterozygosity
  let color-het ifelse-value (allele-color-1 != allele-color-2) [ 1 ] [ 0 ]
  let size-het  ifelse-value (allele-size-1  != allele-size-2)  [ 1 ] [ 0 ]
  report (color-het + size-het) / 2
end

to-report mean-heterozygosity [agentset]
  ifelse any? agentset
  [ report mean [ snail-heterozygosity ] of agentset ]
  [ report 0 ]
end

to-report count-sexual
  report count snails with [ sex = "male" or sex = "female" ]
end

to-report count-asexual
  report count snails with [ sex = "asexual" ]
end

to-report count-selfing
  report count snails with [ sex = "self-fertile" ]
end

to-report pct-sexual
  ifelse any? snails
  [ report precision (100 * count-sexual / count snails) 2 ]
  [ report 0 ]
end

to-report pct-asexual
  ifelse any? snails
  [ report precision (100 * count-asexual / count snails) 2 ]
  [ report 0 ]
end

to-report pct-selfing
  ifelse any? snails
  [ report precision (100 * count-selfing / count snails) 2 ]
  [ report 0 ]
end

to-report strip-index-of [px]
  let W world-width
  let idx floor ((px - min-pxcor) / (W / n-strips))
  report min (list (n-strips - 1) max (list 0 idx))
end

to record-output
  set mean-het-asexual mean-heterozygosity (snails with [ sex = "asexual" ])
  set mean-het-sexual  mean-heterozygosity (snails with [ sex = "male" or sex = "female" ])
  set mean-het-selfing mean-heterozygosity (snails with [ sex = "self-fertile" ])

  ;; strategy counts in n-strips vertical strips
  let asex-counts n-values n-strips [ 0 ]
  let sex-counts  n-values n-strips [ 0 ]
  let self-counts n-values n-strips [ 0 ]
  let tot-counts  n-values n-strips [ 0 ]

  ask snails [
    let i strip-index-of pxcor
    set tot-counts replace-item i tot-counts ((item i tot-counts) + 1)
    if sex = "asexual" [
      set asex-counts replace-item i asex-counts ((item i asex-counts) + 1)
    ]
    if sex = "male" or sex = "female" [
      set sex-counts replace-item i sex-counts ((item i sex-counts) + 1)
    ]
    if sex = "self-fertile" [
      set self-counts replace-item i self-counts ((item i self-counts) + 1)
    ]
  ]

  ;; rolling window of last ~500 ticks
  set strip-asexual-sum (map + strip-asexual-sum asex-counts)
  set strip-sexual-sum  (map + strip-sexual-sum sex-counts)
  set strip-selfing-sum (map + strip-selfing-sum self-counts)
  set strip-total-sum   (map + strip-total-sum tot-counts)
  set strip-sample-count (strip-sample-count + 1)

  if strip-sample-count > samples-in-window [
    ;; drop one average sample-worth by scaling (approximate FIFO via proportional decay)
    let keep ((samples-in-window - 1) / samples-in-window)
    set strip-asexual-sum map [ v -> v * keep ] strip-asexual-sum
    set strip-sexual-sum  map [ v -> v * keep ] strip-sexual-sum
    set strip-selfing-sum map [ v -> v * keep ] strip-selfing-sum
    set strip-total-sum   map [ v -> v * keep ] strip-total-sum
    set strip-sample-count samples-in-window
  ]

  update-boundary-metrics
end

to update-boundary-metrics
  let asex-shares strip-shares strip-asexual-sum
  let sex-shares  strip-shares strip-sexual-sum
  let self-shares strip-shares strip-selfing-sum

  set boundary-position-asexual crossing-position asex-shares 0.50
  set boundary-width-asexual    boundary-width-of asex-shares
  set boundary-position-sexual  crossing-position sex-shares 0.50
  set boundary-width-sexual     boundary-width-of sex-shares
  set boundary-position-selfing crossing-position self-shares 0.50
  set boundary-width-selfing    boundary-width-of self-shares
end

to-report strip-shares [count-list]
  report (map [ [c t] -> ifelse-value (t > 0) [ c / t ] [ 0 ] ] count-list strip-total-sum)
end

;; Position (0..1 along x) where strategy share crosses threshold, or -1 if none.
to-report crossing-position [shares threshold]
  let i 0
  while [ i < (n-strips - 1) ] [
    let a item i shares
    let b item (i + 1) shares
    if (a - threshold) * (b - threshold) <= 0 and (a != b) [
      let frac (threshold - a) / (b - a)
      let pos ((i + frac + 0.5) / n-strips)
      report pos
    ]
    set i (i + 1)
  ]
  report -1
end

to-report boundary-width-of [shares]
  let p25 crossing-position shares 0.25
  let p75 crossing-position shares 0.75
  ifelse (p25 < 0) or (p75 < 0)
  [ report -1 ]
  [ report abs (p75 - p25) ]
end

;; Strip share reporters for BehaviorSpace (current instantaneous, not rolling)
to-report strip-strategy-share [strategy-name strip-i]
  let W world-width
  let left-x  (min-pxcor + strip-i * (W / n-strips))
  let right-x (min-pxcor + (strip-i + 1) * (W / n-strips))
  let in-strip snails with [ pxcor >= left-x and pxcor < right-x ]
  if strip-i = (n-strips - 1) [
    set in-strip snails with [ pxcor >= left-x and pxcor <= max-pxcor ]
  ]
  if not any? in-strip [ report 0 ]
  if strategy-name = "asexual" [
    report (count in-strip with [ sex = "asexual" ]) / (count in-strip)
  ]
  if strategy-name = "sexual" [
    report (count in-strip with [ sex = "male" or sex = "female" ]) / (count in-strip)
  ]
  if strategy-name = "selfing" [
    report (count in-strip with [ sex = "self-fertile" ]) / (count in-strip)
  ]
  report 0
end
]]></code>
